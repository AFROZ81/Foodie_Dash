<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodieDash</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FoodieDash.styles.css" asp-append-version="true" />

    <style>
        /* --- CORE THEME --- */
        :root {
            --primary-orange: #ff6b6b;
            --dark-text: #2d3436;
            --gradient-dark: linear-gradient(135deg, #2d3436 0%, #000000 100%);
            --gradient-orange: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f8f9fa;
            padding-top: 85px; /* Added slight extra space for the fixed header */
        }

        /* --- NAVBAR --- */
        .navbar {
            background-color: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px); /* Modern frosted glass effect */
            box-shadow: 0 4px 20px rgba(0,0,0,0.04);
            padding: 0.8rem 1rem;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.6rem;
            color: var(--dark-text) !important;
            letter-spacing: -0.5px;
        }

        .text-orange {
            color: var(--primary-orange);
        }

        /* --- PROFESSIONAL NAV LINKS (Sliding Underline) --- */
        .navbar-nav .nav-link {
            color: #636e72 !important;
            font-weight: 500;
            margin: 0 5px;
            padding: 8px 10px;
            position: relative;
            transition: color 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px; /* Space between icon and text */
        }

            .navbar-nav .nav-link i {
                font-size: 1.1rem;
                margin-bottom: 2px;
                transition: transform 0.3s ease;
            }

            /* The Animated Line */
            .navbar-nav .nav-link::after {
                content: '';
                position: absolute;
                width: 0;
                height: 2px;
                bottom: 0;
                left: 50%;
                background-color: var(--primary-orange);
                transition: all 0.3s ease-in-out;
                transform: translateX(-50%);
                border-radius: 2px;
            }

            /* Hover Effects */
            .navbar-nav .nav-link:hover {
                color: var(--primary-orange) !important;
            }

                .navbar-nav .nav-link:hover i {
                    transform: translateY(-2px); /* Subtle bounce */
                }

                .navbar-nav .nav-link:hover::after,
                .navbar-nav .nav-link.active::after {
                    width: 80%; /* Line expands */
                }

            .navbar-nav .nav-link.active {
                color: var(--dark-text) !important;
                font-weight: 600;
            }

        /* --- CART BUTTON (KEPT AS REQUESTED) --- */
        .btn-cart {
            position: relative;
            background-color: #fff0f0;
            color: var(--primary-orange);
            border: none;
            padding: 8px 15px;
            border-radius: 50px;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            text-decoration: none;
        }

            .btn-cart:hover {
                background-color: var(--primary-orange);
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 4px 10px rgba(255, 107, 107, 0.3);
            }

        .cart-badge {
            background-color: var(--dark-text);
            color: white;
            font-size: 0.75rem;
            padding: 2px 6px;
            border-radius: 10px;
            margin-left: 8px;
        }

        /* --- USER PROFILE PILL --- */
        .btn-user {
            background-color: #f1f2f6;
            color: var(--dark-text);
            font-weight: 600;
            padding: 5px 16px 5px 5px; /* Padding logic for pill shape */
            border-radius: 50px;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            border: 1px solid transparent;
        }

            .btn-user .user-avatar {
                width: 32px;
                height: 32px;
                background-color: white;
                color: var(--primary-orange);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            }

            .btn-user:hover, .btn-user.show {
                background-color: white;
                border-color: #e0e0e0;
                box-shadow: 0 5px 15px rgba(0,0,0,0.08);
                color: var(--primary-orange);
            }

        /* Dropdown Menu styling */
        .dropdown-menu {
            border-radius: 15px;
            padding: 10px;
            margin-top: 15px !important;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            border: 1px solid rgba(0,0,0,0.05);
            animation: fadeIn 0.2s ease-out;
        }

        .dropdown-item {
            border-radius: 8px;
            padding: 8px 15px;
            font-weight: 500;
            color: #636e72;
        }

            .dropdown-item:hover {
                background-color: #fff0f0;
                color: var(--primary-orange);
            }

        /* --- AUTH BUTTONS --- */
        .btn-login-nav {
            font-weight: 600;
            color: var(--dark-text);
            padding: 8px 15px;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .btn-login-nav:hover {
                color: var(--primary-orange);
                text-decoration: none;
            }

        .btn-signup-nav {
            background: var(--gradient-dark);
            color: white;
            border-radius: 50px;
            padding: 8px 24px;
            font-weight: 600;
            font-size: 0.95rem;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .btn-signup-nav:hover {
                background: var(--gradient-orange);
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(255, 107, 107, 0.3);
            }

        /* Footer */
        .footer {
            background: white;
            padding: 25px 0;
            font-size: 0.9rem;
            border-top: 1px solid #f1f1f1;
            color: #b2bec3;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light fixed-top">
            <div class="container">

                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-fire text-orange"></i> Foodie<span class="text-orange">Dash</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav ms-auto align-items-center">

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>

                        @if (User.Identity.IsAuthenticated && User.Identity.Name == "Afroz")
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Category" ? "active" : "")"
                                   asp-controller="Category" asp-action="Index">
                                    <i class="bi bi-grid"></i> Categories
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "MenuItem" ? "active" : "")"
                                   asp-controller="MenuItem" asp-action="Index">
                                    <i class="bi bi-menu-button-wide"></i> Menu Items
                                </a>
                            </li>
                        }

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item my-2 my-lg-0 ms-lg-2">
                                <a class="btn-cart" asp-controller="Cart" asp-action="Index">
                                    <i class="bi bi-cart3 me-1"></i> Cart
                                    <span id="cart-count-badge" class="cart-badge">0</span>
                                </a>
                            </li>

                            <li class="nav-item dropdown ms-lg-3">
                                <a class="nav-link dropdown-toggle btn-user" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="user-avatar">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <span>@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li><span class="dropdown-header text-uppercase text-muted small" style="font-size: 0.7rem; letter-spacing: 1px;">Signed in as</span></li>
                                    <li><div class="px-3 fw-bold text-dark pb-2">@User.Identity.Name</div></li>
                                    <li><hr class="dropdown-divider my-2"></li>
                                    <li>
                                        <a class="dropdown-item text-danger fw-bold" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i> Log Out
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-3">
                                <a class="btn-login-nav text-decoration-none" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Log In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn-signup-nav" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus-fill"></i> Sign Up
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container" style="margin-bottom: 80px;">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted text-center">
        <div class="container">
            &copy; 2026 - FoodieDash - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>